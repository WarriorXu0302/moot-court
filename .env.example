# ============================================
# 站内登录（学号 + 密码）
# ============================================
# 教师端密码（必填）：没有默认值，未配置时教师端登录返回 503。
# 这是教师端唯一的门槛，请使用足够强的密码。
TEACHER_PASSWORD=
# 登录会话签名密钥（建议配置，至少 32 位随机串，例如 `openssl rand -hex 32`）。
# 未配置时由 COZE_SUPABASE_SERVICE_ROLE_KEY 派生；一旦更换该值，所有已登录用户需重新登录。
AUTH_SECRET=

# ============================================
# Supabase（Coze 实例化后自动注入，本地开发需手动填写）
# ============================================
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
# 建号与签发一次性登录链接需要 service role，仅服务端使用
COZE_SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# 自定义 LLM（OpenAI 兼容接口，可选）
# ============================================
# 三项都配置时，服务端对话 / 总结 / 案例生成 / 评分标准生成改走该接口（POST {BASE_URL}/v1/chat/completions，SSE 流式）；
# 任一缺失则回落到平台 SDK（豆包）。密钥只在服务端读取，不会下发到浏览器。
# 注意模型名要与服务商 GET /v1/models 返回的 id 完全一致（例如 gpt-6.1-sol，写成 gpt6.1sol 会 403）。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
